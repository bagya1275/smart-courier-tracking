# MongoDB Atlas connection string. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://bagya1275_db_user:<PASSWORD>@smartcouriercluster.mtiwups.mongodb.net/smart_courier_db?retryWrites=true&w=majority&appName=SmartCourierCluster

# Generate a unique long random value for production. Do not commit the real value.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRATION_MS=86400000

# Same-origin deployment can leave this as the default. For a separate frontend,
# use its exact public origin, e.g. https://your-frontend.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# true for the included demo accounts/data; false for a clean production database.
SEED_DEMO_DATA=true
